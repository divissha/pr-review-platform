# Copy to .env and fill in what you need. Everything has a dev default except the API keys.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Leave empty for SQLite (zero setup). For Postgres:
# DATABASE_URL=postgres://prism:prism@localhost:5432/prism
DATABASE_URL=

# 1 = run tasks inline (no Redis needed). 0 = use a real Celery worker.
CELERY_EAGER=1
REDIS_URL=redis://localhost:6379/0

# GitHub: token is needed for live ingest + batch collection (rate limits!)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# LLM scorer
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_DIFF_CHARS=24000
